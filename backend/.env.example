# ── App ────────────────────────────────────────────────
APP_NAME="QA Argus API"
ENV=dev

# ── Banco de dados ─────────────────────────────────────
# Dev local (padrão): SQLite async, roda sem infra.
DATABASE_URL=sqlite+aiosqlite:///./qa_argus.db
# Produção (Supabase Session Pooler, IPv4, porta 5432):
# DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<senha>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── Segurança / JWT ────────────────────────────────────
SECRET_KEY=troque-esta-chave-em-producao-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS (URLs do frontend, separadas por vírgula) ─────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Storage de evidências ──────────────────────────────
# Dev: disco local. Produção: Supabase Storage (bucket).
STORAGE_DIR=./storage
PUBLIC_BASE_URL=http://localhost:8080

# ── Bootstrap ──────────────────────────────────────────
AUTO_CREATE_TABLES=true
SEED_ON_START=true
DEMO_USER_NAME=Arthur Renzo
DEMO_USER_EMAIL=arthur@qaargus.dev
DEMO_USER_PASSWORD=argus123
