# ============================================================
#  QA Argus — variáveis de ambiente (configurar no EasyPanel)
#  Copie para .env apenas em dev local. Em produção, defina no painel.
# ============================================================

# ── Backend ────────────────────────────────────────────────
# Supabase Session Pooler (IPv4, porta 5432), driver asyncpg:
DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
SECRET_KEY=troque-por-uma-chave-forte   # openssl rand -hex 32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# URL pública do frontend (para o CORS):
CORS_ORIGINS=https://qa-frontend.seu-dominio.com
# URL pública do backend (para as URLs de evidências):
PUBLIC_BASE_URL=https://qa-backend.seu-dominio.com

AUTO_CREATE_TABLES=true
SEED_ON_START=false

# Supabase (Storage/admin) e IA:
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role_key>
OPENAI_API_KEY=<sk-...>
ANTHROPIC_API_KEY=

# ── Frontend (build-arg) ───────────────────────────────────
# URL pública do backend — embutida no bundle em tempo de build:
VITE_API_URL=https://qa-backend.seu-dominio.com
